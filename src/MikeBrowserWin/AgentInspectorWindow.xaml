<Window x:Class="MikeBrowserWin.AgentInspectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MikeBrowser · Agent" Height="620" Width="740"
        WindowStartupLocation="CenterOwner" Background="#0F1512"
        Icon="assets/mikebrowser.ico">
    <Window.Resources>
        <DataTemplate x:Key="LineTpl">
            <TextBlock Text="{Binding}" Foreground="#D8E0DA" TextWrapping="Wrap" Margin="0,3" FontSize="13"/>
        </DataTemplate>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#161D19" Padding="16,12">
            <StackPanel>
                <TextBlock Text="MikeBrowser · Agent" Foreground="#37C871" FontSize="17" FontWeight="Bold"/>
                <TextBlock x:Name="StatusText" Foreground="#8ea79a" FontSize="12" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>
        <TabControl Background="#0F1512" BorderThickness="0">
            <TabItem Header="Messages">
                <ScrollViewer>
                    <StackPanel Margin="14">
                        <TextBlock x:Name="MsgEmpty" Text="No hive messages yet." Foreground="#5f7a6c" FontSize="13"/>
                        <ItemsControl x:Name="MsgList" ItemTemplate="{StaticResource LineTpl}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Skills">
                <ScrollViewer>
                    <ItemsControl x:Name="SkillList" Margin="14" ItemTemplate="{StaticResource LineTpl}"/>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Soul">
                <ScrollViewer>
                    <StackPanel Margin="14">
                        <TextBlock x:Name="PersonaText" Foreground="#E8EFE9" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,14"/>
                        <TextBlock Text="Standing goals" Foreground="#37C871" FontWeight="Bold" Margin="0,0,0,4"/>
                        <ItemsControl x:Name="GoalList" ItemTemplate="{StaticResource LineTpl}" Margin="0,0,0,14"/>
                        <TextBlock Text="Memory" Foreground="#37C871" FontWeight="Bold" Margin="0,0,0,4"/>
                        <ItemsControl x:Name="MemList" ItemTemplate="{StaticResource LineTpl}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
